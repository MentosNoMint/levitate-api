DATABASE_URL=sqlite+aiosqlite:///dev.db
REDIS_URL=redis://localhost:6379/0
# Password for the Postgres container (used by docker-compose.yml via ${POSTGRES_PASSWORD})
# On dev: any value works. On production: use a strong random password.
POSTGRES_PASSWORD=password
ENCRYPTION_KEY=
NEXT_PUBLIC_API_URL=http://localhost:8000
# Port binding for backend (default: 8000:8000). On server use: 127.0.0.1:8001:8000
BACKEND_PORT_BINDING=8000:8000
GOOGLE_USER_PROJECT=
APP_ENV=development
ALLOW_MOCK_AUTH=true
ALLOWED_ADMIN_EMAILS=admin@levitate.ai,dev-user@levitate.ai

# Domain Configuration (for Traefik reverse proxy)
DOMAIN_FRONTEND=localhost
DOMAIN_BACKEND=api.localhost
ACME_EMAIL=admin@your-domain.com

# Authentication & Security
AUTH_SECRET=
FRONTEND_URL=http://localhost:3000
AUTH_METHOD=both
ADMIN_TOKEN=dev-admin-token-for-local-testing-12345

# Google OAuth Configuration
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8000/admin/auth/callback

# Antigravity OAuth Configuration (public keys from Google's Cloud Code extension)
ANTIGRAVITY_OAUTH_CLIENT_ID=1071006060591-tmhssin2h21lcre235vtolojh4g403ep.apps.googleusercontent.com
ANTIGRAVITY_OAUTH_CLIENT_SECRET=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
# Direct Google URL (OK for non-RU local). For geo-blocked regions use Cloudflare Worker path-style:
# ANTIGRAVITY_CLOUD_CODE_ENDPOINT=https://<worker>.workers.dev/daily-cloudcode-pa.googleapis.com
# See docs/cloudflare-worker-proxy.md
ANTIGRAVITY_CLOUD_CODE_ENDPOINT=https://daily-cloudcode-pa.googleapis.com
