# ============================================================
#  Levitate API — Production Environment Template
#  Copy this file to .env and fill in all required values.
#  NEVER commit the filled .env to version control.
# ============================================================

# --- Database ---
# In Docker: DATABASE_URL and REDIS_URL are injected by docker-compose.yml automatically
# using POSTGRES_PASSWORD from this file. You do NOT need to set DATABASE_URL here.
# docker-compose constructs it as:
#   postgresql+asyncpg://postgres:${POSTGRES_PASSWORD}@postgres:5432/gateway
#
# Just set the password:
POSTGRES_PASSWORD=CHANGE_ME_USE_A_STRONG_RANDOM_PASSWORD

# --- Redis ---
# In Docker: REDIS_URL is also set automatically by docker-compose.yml (redis://redis:6379/0).
# You do NOT need to set REDIS_URL in .env when using Docker.

# --- Encryption ---
# AES key for encrypting stored API credentials.
# Generate with: python -c "import base64, os; print(base64.urlsafe_b64encode(os.urandom(32)).decode())"
# Must be exactly 32 bytes (base64-encoded).
# REQUIRED — do NOT leave empty or use default values.
ENCRYPTION_KEY=CHANGE_ME_GENERATE_A_STRONG_32_BYTE_KEY

# --- Environment ---
APP_ENV=production

# Mock auth is automatically disabled when APP_ENV=production.
# The line below is ignored in production but kept for documentation.
ALLOW_MOCK_AUTH=false

# --- Admin Access ---
# Comma-separated list of Google email addresses allowed to log in as admin.
# These users will be created/promoted to 'admin' role on first login.
ALLOWED_ADMIN_EMAILS=youremail@gmail.com

# --- Auth Method ---
# Controls which login methods are shown on the login screen.
# Options:
#   google - only Google OAuth button
#   token  - only Admin Token password field
#   both   - Google OAuth + Token field (default)
AUTH_METHOD=token

# --- Admin Token ---
# Secret token for logging into the dashboard via token method.
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
# REQUIRED if AUTH_METHOD is 'token' or 'both'.
# In production, must be at least 16 characters long.
ADMIN_TOKEN=CHANGE_ME_GENERATE_A_STRONG_RANDOM_TOKEN

# --- JWT Session Signing Secret ---
# Used to sign and verify session tokens.
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
# REQUIRED — must be a long random string.
AUTH_SECRET=CHANGE_ME_GENERATE_A_LONG_RANDOM_SECRET

# --- Domain and Traefik Configuration ---
# Set these domains to route traffic through Traefik and obtain automatic SSL.
DOMAIN_FRONTEND=your-domain.com
DOMAIN_BACKEND=api.your-domain.com

# Email used by Let's Encrypt for certificate notifications and expiry alerts.
ACME_EMAIL=your-email@gmail.com

# --- URLs ---
# The publicly accessible URL of your frontend (no trailing slash).
# Should match DOMAIN_FRONTEND with https.
FRONTEND_URL=https://your-domain.com

# The publicly accessible URL of your backend API (no trailing slash).
# Should match DOMAIN_BACKEND with https.
NEXT_PUBLIC_API_URL=https://api.your-domain.com

# --- Google OAuth (for admin panel login) ---
# Required only if AUTH_METHOD is 'google' or 'both'.
# Create credentials at: https://console.cloud.google.com/apis/credentials
# Redirect URI must be registered in Google Console as:
#   https://api.your-domain.com/admin/auth/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=https://api.your-domain.com/admin/auth/callback

# --- Antigravity Google OAuth (for connecting upstream Google accounts) ---
# This is separate from the admin login OAuth.
# Required for the "Connect Google" button in the Credentials tab.
ANTIGRAVITY_OAUTH_CLIENT_ID=
ANTIGRAVITY_OAUTH_CLIENT_SECRET=
ANTIGRAVITY_CLOUD_CODE_ENDPOINT=https://daily-cloudcode-pa.googleapis.com

# --- Google Cloud Project ---
# Used for Antigravity Google account quota resolution.
GOOGLE_USER_PROJECT=levitate-api
